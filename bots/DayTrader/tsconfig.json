{
    "compilerOptions": {
        // Mirrors the repo root tsconfig.json compiler options, scoped to
        // bots/DayTrader so the vendored server/engine and webclient trees
        // (which have their own dedicated tsconfig) are never pulled into
        // this program just because DayTrader imports a few sdk types.
        "lib": ["ESNext", "DOM"],
        "target": "ESNext",
        "module": "ESNext",
        "moduleDetection": "force",
        "allowJs": true,

        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "noEmit": true,

        "strict": true,
        "skipLibCheck": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedIndexedAccess": true,

        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "noPropertyAccessFromIndexSignature": false
    },
    "include": ["**/*.ts"],
    "exclude": ["node_modules", "data"]
}
